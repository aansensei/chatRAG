# Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@your-host:5432/postgres

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Vector DB — Supabase (pgvector) is the active backend, code reads these two vars
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM Provider: openai | groq | ollama
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Cerebras (fast free inference — https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Anthropic (Claude — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding — changing model requires re-ingesting all documents (vector dimension changes)
# Options (sentence-transformers, run locally):
#   all-MiniLM-L6-v2   → 384 dims, CPU-friendly, ~80MB, English-focused (default)
#   BAAI/bge-m3         → 1024 dims, multilingual incl. Vietnamese, best quality
# Options (Ollama, must have model pulled via `ollama pull`):
#   nomic-embed-text    → 768 dims, fast, 8192 ctx, run via Ollama
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage: local | minio
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# MinIO (chỉ cần nếu STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatrag

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Google Custom Search (web browsing mode) — https://programmablesearchengine.google.com/
# Free tier: 100 queries/day. Falls back to DuckDuckGo automatically if unset or quota exceeded.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Retrieval
RETRIEVAL_TOP_K=15
RERANK_TOP_K=8

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
