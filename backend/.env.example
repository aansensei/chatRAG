# Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@your-host:5432/postgres

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM Provider: openai | groq | ollama
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Storage: local | minio
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# MinIO (chỉ cần nếu STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatrag

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Retrieval
RETRIEVAL_TOP_K=15
RERANK_TOP_K=8

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
