# Redis (job queue broker)
REDIS_URL=redis://localhost:6379/0

# Vector DB — Supabase (pgvector) is the only backend, code reads these two vars
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Cloud LLM providers — the model picker in the UI can send a per-request key instead,
# but setting one here makes that model usable without every user having their own key.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Cerebras (fast free inference — https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Anthropic (Claude — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Embedding — changing model requires re-ingesting all documents (vector dimension changes)
# BAAI/bge-m3 → 1024 dims, multilingual incl. Vietnamese, best quality (in production use)
EMBEDDING_MODEL=BAAI/bge-m3

# Force the main API process's embedder onto a specific device (cpu/cuda). Spawned
# workers ignore this and always use GPU — see backend/README.md.
EMBEDDING_DEVICE=

LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_MB=50

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@aanjsc.vn
ADMIN_PASSWORD=

# Retrieval
RETRIEVAL_TOP_K=15
RERANKER_ENABLED=true

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
RATE_LIMIT_PER_MINUTE=30
